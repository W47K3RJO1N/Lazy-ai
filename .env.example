# LazyFlow AI Environment Configuration
# When these variables are omitted, LazyFlow operates seamlessly in offline Demo Mode.

# 1. Base URL for OpenAI-compatible completions endpoint
# Examples:
#   Together AI: https://api.together.xyz/v1
#   Groq: https://api.groq.com/openai/v1
#   Local Ollama: http://localhost:11434/v1
#   Local vLLM: http://localhost:8000/v1
AI_API_BASE_URL=https://api.together.xyz/v1

# 2. Secret API Key (kept strictly server-side, never exposed to NEXT_PUBLIC_*)
AI_API_KEY=your_api_key_here

# 3. Model identifier (Open-weight models recommended)
# Examples:
#   Qwen/Qwen2.5-72B-Instruct
#   google/gemma-2-27b-it
#   meta-llama/Llama-3.3-70B-Instruct
AI_MODEL=Qwen/Qwen2.5-72B-Instruct
